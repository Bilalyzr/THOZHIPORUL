# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Transient runtime logs (backend boot/vite dev output)
*.log
.boot.log
.vite.log

# Environment (ALL env files with real secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.prod

# Caddy persistent state (auto-generated by the reverse proxy)
caddy_data/
caddy_config/

# Docker volumes (if local-mounted for dev)
.db_data/

# Build
dist/
build/
.next/
out/
.docusaurus/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Project specific
backend/node_modules/
frontend/node_modules/
frontend/dist/

# Secure Vault uploads — real user files, never commit
backend/uploads/*
!backend/uploads/.gitkeep

# Temporary / Analysis
*.txt
*.docx
*.heapsnapshot
*.heapprofile
system_flow_diagram.md
.zcode/

# Documentation, assets, and demo materials (not needed for execution)
docs/
assets/
demo/
