# SIPCOT SIMS Backend Environment Variables Template
# Copy this file to .env and customize the values for local development.

# Application Configuration
PORT=5001
NODE_ENV=development

# Database Connection
# By default, DB_HOST should be localhost for local running, or 'db' if running via Docker Compose
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sipcot_sims

# Authentication Secret
# Provide a long, random key for signing JSON Web Tokens
JWT_SECRET=your_long_random_jwt_secret_here

# CORS — comma-separated list of allowed frontend origins.
# In production set this to your deployed frontend URL (e.g. https://your-app.netlify.app).
# Use '*' to allow any origin (NOT recommended for production).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Demo login bypass — MUST be false in production.
# When true, accounts with the '$demo$' placeholder hash and the demo vault
# passphrases are accepted. Leave false for real authentication.
ENABLE_DEMO_LOGIN=false

# ─── Enhancement (v3) integrations — all OPTIONAL ───────────────────
# Email delivery (notifications + scheduled reports). If unset, emails
# are logged to the console instead of sent (dev mode).
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=no-reply@thozhirporul.tn.gov.in

# SMS delivery (notifications). If unset, SMS attempts are skipped.
# SMS_PROVIDER_KEY=your-sms-provider-key

# Programmatic data submission (Module 9). Industries with ERPs push
# data via /api/submissions/api-submit using this key in x-api-key.
# Generate a strong random string; leave unset to disable API submission.
# SUBMISSION_API_KEY=generate-a-long-random-string
# ─────────────────────────────────────────────────────────────────────
