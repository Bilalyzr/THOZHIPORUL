# SIPCOT SIMS Backend Environment Variables Template
# Copy this file to .env and customize the values for local development.

# Application Configuration
PORT=5001
NODE_ENV=development

# Database Connection
# By default, DB_HOST should be localhost for local running, or 'db' if running via Docker Compose
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sipcot_sims

# Authentication Secret
# Provide a long, random key for signing JSON Web Tokens
JWT_SECRET=your_long_random_jwt_secret_here
