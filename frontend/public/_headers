# Netlify security + caching headers for THOZHIPORUL (THOZHIRPORUL / SIPCOT Industrial OS)
# This file lives in frontend/public/ so Vite copies it into dist/ on build.
# Netlify reads it from the publish directory (dist) and applies the rules below.
# The "_redirects" sibling file handles SPA fallback routing (/* -> /index.html 200).

/*
  # --- Security headers ---
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; frame-src https://api.razorpay.com; worker-src 'self' blob:; manifest-src 'self'

# Long-cache the hashed build assets (Vite fingerprints them, so they're immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should always revalidate (entry point — never stale)
/*.html
  Cache-Control: no-cache

# Favicons / icons rarely change
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
