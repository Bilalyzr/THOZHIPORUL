# ============================================================
# .env.prod.example — copy to .env.prod and fill in REAL values.
# NEVER commit .env.prod to git (it's in .gitignore).
#
# Generate a strong JWT secret:
#   openssl rand -hex 48
# Generate a strong DB password:
#   openssl rand -hex 24
# ============================================================

# ─── Database ───
# The Postgres credentials. These become the DB user/password on first boot.
DB_USER=sipcot_admin
DB_PASSWORD=GENERATE_A_STRONG_PASSWORD_HERE
DB_NAME=sipcot_sims

# ─── Auth ───
# JWT signing secret. MUST be at least 32 characters. Generate with:
#   openssl rand -hex 48
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ─── CORS ───
# The exact frontend URL (https + your domain). Comma-separated for multiple.
# NEVER use '*' in production.
CORS_ORIGIN=https://thozhirporul.tn.gov.in

# ─── Payments (Razorpay) ───
# REQUIRED in production. Get from https://dashboard.razorpay.com/
# If unset, subscription upgrades will 503 (but the rest of the app works).
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── SIPCOT Sync API key ───
# Required for the /api/sipcot-sync integration. If unset, that endpoint
# returns 503 (non-fatal).
SIPCOT_API_KEY=your_sipcot_api_key

# ─── Domain (for Caddy SSL) ───
# Must match the domain in Caddyfile. Caddy uses this to provision certs.
DOMAIN=thozhirporul.tn.gov.in
